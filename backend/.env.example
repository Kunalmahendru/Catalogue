# Leave SUPABASE_* empty to serve the built-in sample designs (app/seed.py).
SUPABASE_URL=
# Project Settings -> API -> publishable key (read-only, safe for the live API).
SUPABASE_PUBLISHABLE_KEY=

# Only needed on your own machine for one-off imports/admin scripts. NEVER set this on Vercel
# or commit it: it bypasses all security rules.
SUPABASE_SECRET_KEY=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
